# Paths resolve against the process working directory; use an absolute path for MCP clients.
COACH_DATA_DIR=../coach-data
TRANSPORT=stdio
HOST=127.0.0.1
PORT=3000
# HTTP only: generate with openssl rand -hex 32
# MCP_TOKEN=
# PUBLIC_URL=https://coach.bananer.at
# Personal Intervals API key (not your account password); athlete 0 means key owner.
# INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
ENABLE_DATA_WRITES=false
# Hosted production: enable after configuring a clean checkout, origin and upstream.
GIT_AUTO_PUSH=false
# Hosted production with GIT_AUTO_PUSH: host paths mounted into the container for Git push.
# COACH_DATA_DEPLOY_KEY=/home/<user>/.ssh/deploy-coach-data
# GIT_KNOWN_HOSTS=/home/<user>/.ssh/known_hosts
